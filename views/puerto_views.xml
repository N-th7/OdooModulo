<odoo>
  <record id="view_puerto_tree" model="ir.ui.view">
    <field name="name">internet.puerto.tree</field>
    <field name="model">internet.puerto</field>
    <field name="arch" type="xml">
      <tree decoration-success="estado=='disponible'" decoration-danger="estado=='dañado'" decoration-warning="estado=='mantenimiento'">
        <field name="name"/>
        <field name="numero"/>
        <field name="tipo"/>
        <field name="estado"/>
        <field name="ubicacion"/>
      </tree>
    </field>
  </record>

  <record id="view_puerto_form" model="ir.ui.view">
    <field name="name">internet.puerto.form</field>
    <field name="model">internet.puerto</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <field name="estado" widget="statusbar" statusbar_visible="disponible,ocupado,mantenimiento,dañado"/>
        </header>
        <sheet>
          <group>
            <group>
              <field name="name"/>
              <field name="numero"/>
              <field name="tipo"/>
            </group>
            <group>
              <field name="ubicacion"/>
            </group>
          </group>
          <group>
            <field name="observaciones" placeholder="Observaciones sobre el puerto"/>
          </group>
          <notebook>
            <page string="Instalaciones">
              <field name="instalacion_ids">
                <tree>
                  <field name="contrato_id"/>
                  <field name="fecha_instalacion"/>
                  <field name="estado"/>
                </tree>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_puertos" model="ir.actions.act_window">
    <field name="name">Puertos</field>
    <field name="res_model">internet.puerto</field>
    <field name="view_mode">tree,form</field>
  </record>

  <menuitem id="menu_puertos" 
            name="Puertos" 
            parent="menu_internet_root"
            action="action_puertos"/>

</odoo>