<odoo>
  <record id="view_internet_invoice_tree" model="ir.ui.view">
    <field name="name">internet.invoice.tree</field>
    <field name="model">internet.invoice</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name"/>
        <field name="client_id"/>
        <field name="date_invoice"/>
        <field name="due_date"/>
        <field name="amount"/>
        <field name="state"/>
      </tree>
    </field>
  </record>

  <record id="view_internet_invoice_form" model="ir.ui.view">
    <field name="name">internet.invoice.form</field>
    <field name="model">internet.invoice</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="client_id"/>
            <field name="date_invoice"/>
            <field name="due_date"/>
            <field name="amount"/>
            <field name="state"/>
          </group>
          <footer>
            <button name="action_register_payment" type="object" string="Marcar como pagada" class="btn-primary"/>
          </footer>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_internet_invoice_kanban" model="ir.ui.view">
    <field name="name">internet.invoice.kanban</field>
    <field name="model">internet.invoice</field>
    <field name="arch" type="xml">
      <kanban group_by="client_id" default_group_by="client_id">
        <field name="client_id"/>
        <field name="name"/>
        <field name="date_invoice"/>
        <field name="due_date"/>
        <field name="amount"/>
        <field name="state"/>
        <templates>
          <t t-name="kanban-box">
            <div class="oe_kanban_card">
              <div class="o_kanban_record_body">
                <div class="mt-2">
                  <strong><t t-esc="record.name.value"/></strong>
                  <span t-attf-class="badge ms-2 #{record.state.value == 'pagada' and 'bg-success' or record.state.value == 'impaga' and 'bg-danger' or 'bg-warning'}">
                    <t t-esc="record.state.value"/>
                  </span>
                </div>
                <div class="row mt-2 text-muted small">
                  <div class="col-6">
                    <small>Emisión: <t t-esc="record.date_invoice.value"/></small>
                  </div>
                  <div class="col-6">
                    <small>Vence: <t t-esc="record.due_date.value"/></small>
                  </div>
                </div>
                <div class="row mt-2">
                  <div class="col-6">
                    <small class="text-muted">Total:</small>
                    <div><strong>Bs <t t-esc="record.amount.value"/></strong></div>
                  </div>
                  <div class="col-6">
                    <small class="text-muted">Pendiente:</small>
                    <div><strong class="text-danger">Bs <t t-esc="record.amount.value"/></strong></div>
                  </div>
                </div>
                <div class="mt-3">
                  <button name="action_register_payment" type="object" class="btn btn-primary btn-sm" string="Pagar">
                    <i class="fa fa-credit-card"/> Pagar
                  </button>
                </div>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="action_internet_invoices" model="ir.actions.act_window">
    <field name="name">Facturas</field>
    <field name="res_model">internet.invoice</field>
    <field name="view_mode">kanban,tree,form</field>
  </record>

  <menuitem id="menu_internet_invoices" name="Facturas" parent="menu_internet_root" action="action_internet_invoices"/>


</odoo>
