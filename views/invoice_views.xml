<odoo>
  <record id="view_internet_invoice_tree" model="ir.ui.view">
    <field name="name">internet.invoice.tree</field>
    <field name="model">internet.invoice</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name" />
        <field name="contrato_id" />
        <field name="client_id" />
        <field name="fecha_factura" />
        <field name="fecha_vencimiento" />
        <field name="monto_factura" />
        <field name="monto_pagado" />
        <field name="saldo_pendiente" />
        <field name="estado" widget="badge" />
      </tree>
    </field>
  </record>

  <record id="view_internet_invoice_form" model="ir.ui.view">
    <field name="name">internet.invoice.form</field>
    <field name="model">internet.invoice</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <group>
              <field name="name" />
              <field name="contrato_id" />
              <field name="client_id" readonly="1" />
              <field name="fecha_factura" />
              <field name="fecha_vencimiento" />
            </group>
            <group>
              <field name="monto_factura" />
              <field name="monto_pagado" readonly="1" />
              <field name="saldo_pendiente" readonly="1" />
              <field name="estado" />
            </group>
          </group>
          <notebook>
            <page string="Pagos">
              <field name="pago_ids" />
            </page>
            <page string="Avisos de Cobro">
              <field name="aviso_cobro_ids" />
            </page>
          </notebook>
          <footer>
            <button name="action_register_payment" type="object" string="Marcar como pagada"
              class="btn-primary" />
          </footer>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_internet_invoices" model="ir.actions.act_window">
    <field name="name">Facturas</field>
    <field name="res_model">internet.invoice</field>
    <field name="view_mode">kanban,tree,form</field>
  </record>

  <menuitem id="menu_internet_invoices" name="Facturas" parent="menu_internet_root"
    action="action_internet_invoices" />

</odoo>