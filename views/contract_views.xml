<odoo>

    <record id="view_internet_contract_tree" model="ir.ui.view">
        <field name="name">internet.contract.tree</field>
        <field name="model">internet.contract</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code" class="code-highlight"/>
                <field name="client_id" />
                <field name="plan_id" />
                <field name="contract_type" />
                <field name="start_date" />
                <field name="address" />
                <field name="zone" />
                <field name="requires_invoice" />
                <field name="active" />
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_internet_contract_form" model="ir.ui.view">
        <field name="name">internet.contract.form</field>
        <field name="model">internet.contract</field>
        <field name="arch" type="xml">
            <form string="Contrato de Servicio" class="internet_contract_form">
                <sheet>

                    <group>
                        <group>
                            <field name="client_id" />
                            <field name="plan_id" />
                            <field name="contract_type" />
                            <field name="start_date" />
                            <field name="requires_invoice" />
                        </group>

                        <group>
                            <field name="address" />
                            <field name="zone" />
                            <field name="gps" />
                            <field name="reference" />
                            <field name="url_location" />
                        </group>
                    </group>

                    <group>
                        <field name="observations" />
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <record id="action_internet_contracts" model="ir.actions.act_window">
        <field name="name">Contratos</field>
        <field name="res_model">internet.contract</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
    </record>

    <menuitem id="menu_internet_contracts"
        name="Contratos"
        parent="menu_internet_root"
        action="action_internet_contracts" />
</odoo>