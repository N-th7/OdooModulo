<odoo>
  <template id="assets_backend_js" inherit_id="web.assets_backend">
    <xpath expr="." position="inside">
        <script type="module" src="/custom_clients/static/src/js/invoice_dashboard.js"/>
    </xpath>
  </template>

  <template id="invoice_dashboard_styles" inherit_id="web.assets_backend">
    <xpath expr="." position="inside">
        <link rel="stylesheet" href="/custom_clients/static/src/css/invoice_dashboard.css"/>
    </xpath>
  </template>
</odoo>
