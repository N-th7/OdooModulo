<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Invoice Dashboard Template -->
  <template id="invoice_dashboard_template" name="Invoice Dashboard">
    <div class="o_invoice_container">
      <div class="o_control_panel">
        <div class="o_cp_top">
          <div class="o_cp_top_left">
            <h1 class="o_cp_action_name">Dashboard de Facturas por Cliente</h1>
          </div>
        </div>
      </div>
      
      <div class="o_content">
        <div class="container-fluid">
          <div class="row">
            <div class="col-12">
              
              <!-- Resumen general -->
              <t t-if="state.loading">
                <div class="text-center p-4">
                  <i class="fa fa-spinner fa-spin fa-3x"></i>
                  <p>Cargando dashboard...</p>
                </div>
              </t>
              <t t-if="!state.loading and state.dashboardData">
                <div class="row mb-4">
                  <div class="col-md-3">
                    <div class="card bg-primary text-white">
                      <div class="card-body">
                        <h5>Total Facturas</h5>
                        <h3 t-esc="state.dashboardData.total_invoices"/>
                      </div>
                    </div>
                  </div>
                  <div class="col-md-3">
                    <div class="card bg-success text-white">
                      <div class="card-body">
                        <h5>Ingresos</h5>
                        <h3>Bs <t t-esc="state.dashboardData.total_income"/></h3>
                      </div>
                    </div>
                  </div>
                  <div class="col-md-3">
                    <div class="card bg-warning text-white">
                      <div class="card-body">
                        <h5>Pendiente</h5>
                        <h3>Bs <t t-esc="state.dashboardData.total_pending"/></h3>
                      </div>
                    </div>
                  </div>
                  <div class="col-md-3">
                    <div class="card bg-info text-white">
                      <div class="card-body">
                        <h5>Vencidas</h5>
                        <h3 t-esc="state.dashboardData.overdue_count"/>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Facturas agrupadas por cliente -->
                <t t-foreach="state.dashboardData.client_groups" t-as="client_data">
                <div class="o_client_group mb-4">
                  <div class="o_client_header d-flex justify-content-between align-items-center">
                    <div>
                      <h5 class="mb-0">
                        <i class="fa fa-user mr-2"/>
                        <t t-esc="client_data['client_name']"/>
                      </h5>
                      <small class="text-muted">
                        Teléfono: <t t-esc="client_data['client_phone']"/> | 
                        Email: <t t-esc="client_data['client_email']"/>
                      </small>
                    </div>
                    <div class="text-right">
                      <span class="badge badge-info mr-2">
                        <t t-esc="len(client_data['invoices'])"/> facturas
                      </span>
                      <span class="badge badge-warning" t-if="client_data['total_pending'] > 0">
                        Deuda: Bs <t t-esc="client_data['total_pending']"/>
                      </span>
                      <span class="badge badge-success" t-if="client_data['total_pending'] == 0">
                        Al día
                      </span>
                    </div>
                  </div>
                  
                  <div class="o_invoices_list">
                    <t t-foreach="client_data['invoices']" t-as="invoice">
                      <div class="o_invoice_card">
                        <div class="row align-items-center">
                          <div class="col-md-2">
                            <strong t-esc="invoice.name"/>
                            <br/>
                            <small class="text-muted" t-esc="invoice.contrato_id.code if invoice.contrato_id else 'Sin contrato'"/>
                          </div>
                          <div class="col-md-2">
                            <span class="text-muted">Emisión:</span>
                            <br/>
                            <t t-esc="invoice.fecha_factura"/>
                          </div>
                          <div class="col-md-2">
                            <span class="text-muted">Vencimiento:</span>
                            <br/>
                            <t t-esc="invoice.fecha_vencimiento"/>
                          </div>
                          <div class="col-md-2">
                            <span class="text-muted">Monto:</span>
                            <br/>
                            <strong>Bs <t t-esc="invoice.monto_factura"/></strong>
                          </div>
                          <div class="col-md-2">
                            <span class="invoice-state" t-attf-class="invoice-state state-#{invoice.estado}">
                              <t t-esc="invoice.estado.title()"/>
                            </span>
                            <br/>
                            <t t-if="invoice.saldo_pendiente > 0">
                              <small class="text-danger">
                                Saldo: Bs <t t-esc="invoice.saldo_pendiente"/>
                              </small>
                            </t>
                          </div>
                          <div class="col-md-2 text-right">
                            <t t-if="invoice.saldo_pendiente > 0">
                              <button class="btn btn-primary btn-sm pay-invoice-btn" 
                                      t-attf-data-invoice-id="#{invoice.id}"
                                      t-attf-data-amount="#{invoice.saldo_pendiente}"
                                      t-attf-data-invoice-name="#{invoice.name}">
                                <i class="fa fa-credit-card mr-1"/>
                                Pagar
                              </button>
                            </t>
                            <t t-if="invoice.estado == 'pagada'">
                              <span class="badge badge-success">
                                <i class="fa fa-check"/> Pagada
                              </span>
                            </t>
                          </div>
                        </div>
                      </div>
                    </t>
                  </div>
                </div>
              </t>
              </t>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Modal para formulario de pago -->
      <div class="modal fade" id="paymentModal" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title">Registrar Pago</h5>
              <button type="button" class="close" data-dismiss="modal">
                <span aria-hidden="true">×</span>
              </button>
            </div>
            <div class="modal-body">
              <form id="paymentForm">
                <input type="hidden" id="invoice_id" name="invoice_id"/>
                
                <div class="form-group">
                  <label>Factura:</label>
                  <input type="text" class="form-control" id="invoice_name" readonly="readonly"/>
                </div>
                
                <div class="form-group">
                  <label for="amount">Monto a Pagar:</label>
                  <div class="input-group">
                    <div class="input-group-prepend">
                      <span class="input-group-text">Bs</span>
                    </div>
                    <input type="number" class="form-control" id="amount" name="amount" step="0.01" min="0.01" required="required"/>
                  </div>
                </div>
                
                <div class="form-group">
                  <label for="payment_method">Método de Pago:</label>
                  <select class="form-control" id="payment_method" name="payment_method" required="required">
                    <option value="">Seleccionar...</option>
                    <option value="efectivo">Efectivo</option>
                    <option value="transferencia">Transferencia</option>
                    <option value="deposito">Depósito</option>
                    <option value="qr">QR</option>
                    <option value="tarjeta">Tarjeta</option>
                  </select>
                </div>
                
                <div class="form-group">
                  <label for="payment_date">Fecha de Pago:</label>
                  <input type="date" class="form-control" id="payment_date" name="payment_date" required="required"/>
                </div>
                
                <div class="form-group">
                  <label for="reference">Referencia/Número de transacción:</label>
                  <input type="text" class="form-control" id="reference" name="reference"/>
                </div>
                
                <div class="form-group">
                  <label for="observations">Observaciones:</label>
                  <textarea class="form-control" id="observations" name="observations" rows="2"></textarea>
                </div>
              </form>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
              <button type="button" class="btn btn-primary" id="savePayment">Registrar Pago</button>
            </div>
          </div>
        </div>
      </div>
              </t>
            </div>
          </div>
        </div>
      </div>
    </div>
  </template>
</odoo>
