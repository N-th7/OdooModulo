<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================= -->
    <!--      VISTA TREE          -->
    <!-- ========================= -->
    <record id="view_internet_plan_tree" model="ir.ui.view">
        <field name="name">internet.plan.tree</field>
        <field name="model">internet.plan</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="upload_speed"/>
                <field name="download_speed"/>
                <field name="price"/>
                <field name="is_active"/>
            </tree>
        </field>
    </record>



    <!-- ========================= -->
    <!--      VISTA FORM          -->
    <!-- ========================= -->
    <record id="view_internet_plan_form" model="ir.ui.view">
    <field name="name">internet.plan.form</field>
    <field name="model">internet.plan</field>
    <field name="arch" type="xml">

        <form string="Nuevo Plan" class="internet_plan_form">

            <header>
            </header>

            <sheet>

                <!-- Título y subtítulo -->
                <div class="form_title">
                    <h2>Nuevo Plan</h2>
                    <span>Crea un nuevo plan de internet</span>
                </div>

                <group>

                    <!-- Nombre del plan -->
                    <group>
                        <field name="name" placeholder="Ej: Plan 50 Mbps"/>
                    </group>

                    <!-- Velocidades -->
                    <group col="2">
                        <field name="upload_speed" placeholder="10"/>
                        <field name="download_speed" placeholder="10"/>
                    </group>

                    <!-- Precio -->
                    <group>
                        <field name="price" placeholder="200"/>
                    </group>

                    <!-- Descripción -->
                    <group>
                        <field name="description"/>
                    </group>

                    <!-- Switch -->
                    <group>
                        <field name="is_active" widget="boolean_toggle"/>
                    </group>

                </group>

            </sheet>

        </form>

    </field>
</record>



    <!-- ========================= -->
    <!--      VISTA KANBAN        -->
    <!-- ========================= -->
  <record id="view_internet_plan_kanban" model="ir.ui.view">
    <field name="name">internet.plan.kanban</field>
    <field name="model">internet.plan</field>
    <field name="arch" type="xml">
        <kanban class="o_kanban_mobile internet_plan_kanban" 
        t-att-style="'display:grid; grid-template-columns:repeat(4, 1fr); gap:20px;'" archivable="false">

            <!-- CAMPOS A CARGAR -->
            <field name="name"/>
            <field name="price"/>
            <field name="download_speed"/>
            <field name="upload_speed"/>
            <field name="description"/>
            <field name="is_active"/>

            <templates>
                <t t-name="kanban-box">

                    <div style="background:#fff; border-radius:16px; padding:20px;
                                box-shadow:0 4px 10px rgba(0,0,0,0.06); border:1px solid #e5e7eb;
                                display:flex; flex-direction:column; gap:14px;">


                        <!-- Nombre -->
                        <div style="display:flex; align-items:center; gap:12px;">
                          <div class="internet_plan_icon" 
                             style="font-size:28px; display:flex; align-items:center; justify-content:center;
                                    width:48px; height:48px; background:#e0e7ff; border-radius:12px;">
                          <i class="fa fa-wifi" aria-hidden="true" style="color:#4f46e5;"></i>
                        </div>
                        <div style="font-size:18px; font-weight:600;">
                            <t t-if="record.name">
                                <t t-esc="record.name.value"/>
                            </t>
                        </div>
                        </div>

                        <!-- Estado -->
                        <div>
                            <t t-if="record.is_active and record.is_active.raw_value">
                                <span style="background:#10b981;color:#fff;padding:4px 12px;
                                             border-radius:12px;font-size:12px;">Activo</span>
                            </t>
                            <t t-if="record.is_active and !record.is_active.raw_value">
                                <span style="background:#ef4444;color:#fff;padding:4px 12px;
                                             border-radius:12px;font-size:12px;">Inactivo</span>
                            </t>
                        </div>

                        <!-- Descripción -->
                        <div style="color:#6b7280; font-size:14px; min-height:48px;">
                            <t t-if="record.description">
                                <t t-esc="record.description.value"/>
                            </t>
                        </div>

                        <!-- Precio -->
                        <div style="font-size:26px; font-weight:700; color:#111827;">
                            <t t-if="record.price">
                                Bs <t t-esc="record.price.value"/>
                                <span style="font-size:12px; color:#6b7280;">/mes</span>
                            </t>
                        </div>

                        <!-- Velocidad bajada -->
                        <div style="display:flex; align-items:center; gap:6px; color:#374151;">
                            <i class="fa fa-download" style="color:#4f46e5;"></i>
                            <t t-if="record.download_speed">
                                <t t-esc="record.download_speed.value"/> Mbps bajada
                            </t>
                        </div>

                        <!-- Velocidad subida -->
                        <div style="display:flex; align-items:center; gap:6px; color:#374151;">
                            <i class="fa fa-upload" style="color:#4f46e5;"></i>
                            <t t-if="record.upload_speed">
                                <t t-esc="record.upload_speed.value"/> Mbps subida
                            </t>
                        </div>

                        <!-- Botones -->
                        <div style="display:flex; gap:10px; margin-top:10px;">
                            <button type="edit"
                                    style="padding:8px 14px; background:#4f46e5; color:#fff;
                                           border:none; border-radius:8px;">
                                Editar
                            </button>

                            <button type="object" name="action_delete"
                                    style="padding:8px 14px; background:#ef4444; color:#fff;
                                           border:none; border-radius:8px;">
                                Eliminar
                            </button>
                        </div>

                    </div>

                </t>
            </templates>
        </kanban>
    </field>
</record>





    <!-- ========================= -->
    <!--        ACCIÓN            -->
    <!-- ========================= -->
    <record id="action_internet_plans" model="ir.actions.act_window">
        <field name="name">Planes de Internet</field>
        <field name="res_model">internet.plan</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>


    <!-- ========================= -->
    <!--          MENÚ            -->
    <!-- ========================= -->
    <menuitem id="menu_internet_root" name="Internet"/>
    <menuitem id="menu_internet_plans"
              name="Planes"
              parent="menu_internet_root"
              action="action_internet_plans"/>

</odoo>
