<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================= -->
    <!--      VISTA TREE          -->
    <!-- ========================= -->
    <record id="view_internet_plan_tree" model="ir.ui.view">
        <field name="name">internet.plan.tree</field>
        <field name="model">internet.plan</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="upload_speed"/>
                <field name="download_speed"/>
                <field name="price"/>
                <field name="active"/>
            </tree>
        </field>
    </record>


    <!-- ========================= -->
    <!--      VISTA FORM          -->
    <!-- ========================= -->
    <record id="view_internet_plan_form" model="ir.ui.view">
        <field name="name">internet.plan.form</field>
        <field name="model">internet.plan</field>
        <field name="arch" type="xml">
            <form string="Plan de Internet">
                <sheet>
                    <group>
                        <field name="name"/>

                        <group>
                            <field name="upload_speed"/>
                            <field name="download_speed"/>
                        </group>

                        <field name="price"/>
                        <field name="description"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <!-- ========================= -->
    <!--      VISTA KANBAN        -->
    <!-- ========================= -->
    <record id="view_internet_plan_kanban" model="ir.ui.view">
        <field name="name">internet.plan.kanban</field>
        <field name="model">internet.plan</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_card">
                            <div class="oe_kanban_details">

                                <!-- Nombre -->
                                <strong>
                                    <field name="name"/>
                                </strong>

                                <!-- Estado -->
                                <!-- Estado -->
                                <div style="margin:4px 0;">
                                    <t t-if="record.active and record.active.raw_value">
                                        <span class="badge badge-success">Activo</span>
                                    </t>
                                    <t t-if="record.active and !record.active.raw_value">
                                        <span class="badge badge-danger">Inactivo</span>
                                    </t>
                                </div>


                                <!-- Descripción -->
                                <p>
                                    <t t-esc="record.description.value"/>
                                </p>

                                <!-- Precio + velocidad -->
                                <div style="margin-top: 10px;">
                                    <strong>Bs <t t-esc="record.price.value"/></strong> /mes

                                    <div style="margin-top: 4px;">
                                        <i class="fa fa-wifi"/> 
                                        <t t-esc="record.download_speed.value"/> Mbps
                                    </div>
                                </div>

                                <!-- Botones -->
                                <div class="oe_kanban_buttons" style="margin-top: 10px;">
                                    <button type="edit" class="btn btn-primary btn-sm">
                                        Editar
                                    </button>

                                    <button type="object" name="action_delete" class="btn btn-danger btn-sm">
                                        Eliminar
                                    </button>
                                </div>

                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <!-- ========================= -->
    <!--        ACCIÓN            -->
    <!-- ========================= -->
    <record id="action_internet_plans" model="ir.actions.act_window">
        <field name="name">Planes de Internet</field>
        <field name="res_model">internet.plan</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>


    <!-- ========================= -->
    <!--          MENÚ            -->
    <!-- ========================= -->
    <menuitem id="menu_internet_root" name="Internet"/>
    <menuitem id="menu_internet_plans"
              name="Planes"
              parent="menu_internet_root"
              action="action_internet_plans"/>

</odoo>
