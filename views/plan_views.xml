<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================= -->
    <!--      VISTA TREE          -->
    <!-- ========================= -->
    <record id="view_internet_plan_tree" model="ir.ui.view">
        <field name="name">internet.plan.tree</field>
        <field name="model">internet.plan</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="upload_speed"/>
                <field name="download_speed"/>
                <field name="price"/>
                <field name="active"/>
            </tree>
        </field>
    </record>


    <!-- ========================= -->
    <!--      VISTA FORM          -->
    <!-- ========================= -->
    <record id="view_internet_plan_form" model="ir.ui.view">
        <field name="name">internet.plan.form</field>
        <field name="model">internet.plan</field>
        <field name="arch" type="xml">
            <form string="Plan de Internet">
                <sheet>
                    <group>
                        <field name="name"/>

                        <group>
                            <field name="upload_speed"/>
                            <field name="download_speed"/>
                        </group>

                        <field name="price"/>
                        <field name="description"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <!-- ========================= -->
    <!--      VISTA KANBAN        -->
    <!-- ========================= -->
        <!-- ========================= -->
    <!--      VISTA KANBAN        -->
    <!-- ========================= -->
    <record id="view_internet_plan_kanban" model="ir.ui.view">
    <field name="name">internet.plan.kanban</field>
    <field name="model">internet.plan</field>
    <field name="arch" type="xml">
        <kanban class="o_kanban_mobile">

            <!-- CAMPOS QUE ODOO DEBE CARGAR -->
            <field name="name"/>
            <field name="price"/>
            <field name="download_speed"/>
            <field name="upload_speed"/>
            <field name="description"/>
            <field name="active"/>

            <templates>
                <t t-name="kanban-box">

                    <div style="
                        background: #ffffff;
                        border-radius: 16px;
                        border: 1px solid #e5e7eb;
                        padding: 20px;
                        width: 280px;
                        box-shadow: 0 4px 10px rgba(0,0,0,0.06);
                        display: flex;
                        flex-direction: column;
                        gap: 14px;
                    ">

                        <!-- Nombre -->
                        <div style="font-size:18px; font-weight:600;">
                            <t t-if="record.name">
                                <t t-esc="record.name.value"/>
                            </t>
                        </div>

                        <!-- Estado -->
                        <div>
                            <t t-if="record.active and record.active.raw_value">
                                <span style="
                                    background:#10b981;
                                    color:#fff;
                                    padding:4px 12px;
                                    border-radius:12px;
                                    font-size:12px;">
                                    Activo
                                </span>
                            </t>
                            <t t-if="record.active and !record.active.raw_value">
                                <span style="
                                    background:#ef4444;
                                    color:#fff;
                                    padding:4px 12px;
                                    border-radius:12px;
                                    font-size:12px;">
                                    Inactivo
                                </span>
                            </t>
                        </div>

                        <!-- Descripción -->
                        <div style="color:#6b7280; font-size:14px; min-height:48px;">
                            <t t-if="record.description">
                                <t t-esc="record.description.value"/>
                            </t>
                        </div>

                        <!-- Precio -->
                        <div style="font-size:26px; font-weight:700; color:#111827;">
                            <t t-if="record.price">
                                Bs <t t-esc="record.price.value"/>
                                <span style="font-size:12px; color:#6b7280;">/mes</span>
                            </t>
                        </div>

                        <!-- Velocidad bajada -->
                        <div style="font-size:14px; color:#374151; display:flex; gap:6px; align-items:center;">
                            <i class="fa fa-download" style="color:#4f46e5;"></i>
                            <span t-if="record.download_speed">
                                <t t-esc="record.download_speed.value"/> Mbps bajada
                            </span>
                        </div>

                        <!-- Velocidad subida -->
                        <div style="font-size:14px; color:#374151; display:flex; gap:6px; align-items:center;">
                            <i class="fa fa-upload" style="color:#4f46e5;"></i>
                            <span t-if="record.upload_speed">
                                <t t-esc="record.upload_speed.value"/> Mbps subida
                            </span>
                        </div>

                        <!-- Botones -->
                        <div style="display:flex; gap:10px; margin-top:10px;">
                            <button type="edit"
                                style="padding:8px 14px; background:#4f46e5; color:#fff; border:none; border-radius:8px; font-weight:500;">
                                Editar
                            </button>

                            <button type="object" name="action_delete"
                                style="padding:8px 14px; background:#ef4444; color:#fff; border:none; border-radius:8px; font-weight:500;">
                                Eliminar
                            </button>
                        </div>

                    </div>

                </t>
            </templates>
        </kanban>
    </field>
</record>





    <!-- ========================= -->
    <!--        ACCIÓN            -->
    <!-- ========================= -->
    <record id="action_internet_plans" model="ir.actions.act_window">
        <field name="name">Planes de Internet</field>
        <field name="res_model">internet.plan</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>


    <!-- ========================= -->
    <!--          MENÚ            -->
    <!-- ========================= -->
    <menuitem id="menu_internet_root" name="Internet"/>
    <menuitem id="menu_internet_plans"
              name="Planes"
              parent="menu_internet_root"
              action="action_internet_plans"/>

</odoo>
