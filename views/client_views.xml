<odoo>

  <record id="action_contracts_for_client" model="ir.actions.act_window">
    <field name="name">Contratos del Cliente</field>
    <field name="res_model">internet.contract</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[('client_id', '=', active_id)]</field>
  </record>

  <record id="view_internet_client_tree" model="ir.ui.view">
    <field name="name">internet.client.tree</field>
    <field name="model">internet.client</field>
    <field name="arch" type="xml">
      <tree>
        <field name="ci" class="ci-highlight" />
        <field name="name" />
        <field name="phone" />
        <field name="email"/>
        <field name="registration_date" />
        <field name="active" />
      </tree>
    </field>
  </record>

  <record id="view_internet_client_form" model="ir.ui.view">
    <field name="name">internet.client.form</field>
    <field name="model">internet.client</field>
    <field name="arch" type="xml">
      <form string="Cliente de Internet" class="internet_client_form">
        <sheet>

          <!-- SMART BUTTONS -->
          <header>
            <button name="action_add_contract"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-plus">
              <div class="o_stat_info">
                <span>Agregar Contrato</span>
              </div>
            </button>

            <button type="action"
                    name="%(action_contracts_for_client)d"
                    class="oe_stat_button"
                    icon="fa-list">
              <field name="contract_count"
                     widget="statinfo"
                     string="Contratos" />
            </button>
          </header>

          <div class="form_title">
            <h2>Nuevo Cliente</h2>
            <span>Crea un nuevo cliente de internet</span>
          </div>

          <group>
            <group>
              <field name="name" />
              <field name="second_name" />
              <field name="social_reason" />
              <field name="phone" />
              <field name="alternative_phone" />
              <field name="email" />
            </group>

            <group>
              <field name="ci" />
              <group>
                <field name="ci_anverso" widget="image" class="ci-image-field"/>
               
              </group>
              <group>
                <field name="ci_reverso" widget="image" class="ci-image-field"/>
              </group>
              <field name="client_type" />
              <field name="city" />
              <field name="seller_id" />
              <field name="active" />
            </group>
          </group>

          <group>
            <field name="observations" />
          </group>

            <notebook>
            <page string="Contratos">
              <field name="contract_ids">
              <tree>
                <field name="plan_id" />
                <field name="start_date" />
                <field name="contract_type" />
              </tree>

              <form>
                <group>
                <field name="plan_id" />
                <field name="start_date" />
                <field name="contract_type" />
                <field name="address" />
                <field name="zone" />
                <field name="gps" />
                <field name="reference" />
                <field name="url_location" />
                <field name="requires_invoice" />
                <field name="observations" />
                </group>
              </form>

              </field>
            </page>


            <page string="Facturas">
              <field name="invoice_ids">
              <tree>
                <field name="name" />
                <field name="date_invoice" />
                <field name="due_date" />
                <field name="amount" />
                <field name="state" />
              </tree>
              </field>
            </page>
            </notebook>

        </sheet>
      </form>
    </field>
  </record>

  <record id="action_internet_clients" model="ir.actions.act_window">
    <field name="name">Clientes</field>
    <field name="res_model">internet.client</field>
    <field name="view_mode">tree,form</field>
  </record>

  <menuitem id="menu_internet_clients"
            name="Clientes"
            parent="menu_internet_root"
            action="action_internet_clients" />

</odoo>
