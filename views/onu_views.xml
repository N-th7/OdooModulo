<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Tree view -->
  <record id="view_onu_tree" model="ir.ui.view">
    <field name="name">internet.onu.tree</field>
    <field name="model">internet.onu</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name"/>
        <field name="instalacion_id"/>
        <field name="marca"/>
        <field name="modelo"/>
      </tree>
    </field>
  </record>

  <!-- Form view -->
  <record id="view_onu_form" model="ir.ui.view">
    <field name="name">internet.onu.form</field>
    <field name="model">internet.onu</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <group>
              <field name="instalacion_id"/>
              <field name="marca"/>
              <field name="modelo"/>
            </group>
            <group>
              <field name="pot_up"/>
              <field name="wifi_ssid"/>
              <field name="wifi_password"/>
            </group>
          </group>
          <group>
            <field name="observaciones"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Action -->
  <record id="action_internet_onu" model="ir.actions.act_window">
    <field name="name">ONUs</field>
    <field name="res_model">internet.onu</field>
    <field name="view_mode">tree,form</field>
  </record>

  <!-- Menu -->
  <menuitem id="menu_internet_onu" name="ONUs" parent="menu_internet_root" action="action_internet_onu"/>
</odoo>