<odoo>
  <record id="view_tickets_tree" model="ir.ui.view">
    <field name="name">internet.tickets.tree</field>
    <field name="model">internet.tickets</field>
    <field name="arch" type="xml">
      <tree decoration-success="estado=='resuelto'" decoration-danger="prioridad=='critica'" decoration-warning="prioridad=='alta'">
        <field name="cliente_id"/>
        <field name="contrato_id"/>
        <field name="descripcion"/>
        <field name="fecha_reporte"/>
        <field name="estado"/>
        <field name="prioridad"/>
        <field name="tecnico_asignado"/>
      </tree>
    </field>
  </record>

  <record id="view_tickets_form" model="ir.ui.view">
    <field name="name">internet.tickets.form</field>
    <field name="model">internet.tickets</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <field name="estado" widget="statusbar" statusbar_visible="abierto,en_proceso,resuelto,cerrado"/>
        </header>
        <sheet>
          <group>
            <group>
              <field name="cliente_id"/>
              <field name="contrato_id"/>
              <field name="prioridad"/>
              <field name="tecnico_asignado"/>
            </group>
            <group>
              <field name="fecha_reporte"/>
              <field name="fecha_resolucion"/>
            </group>
          </group>
          <group>
            <field name="descripcion" placeholder="Descripción detallada del problema"/>
          </group>
          <group>
            <field name="observaciones" placeholder="Observaciones del técnico"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_tickets_kanban" model="ir.ui.view">
    <field name="name">internet.tickets.kanban</field>
    <field name="model">internet.tickets</field>
    <field name="arch" type="xml">
      <kanban default_group_by="estado" class="o_kanban_small_column">
        <field name="cliente_id"/>
        <field name="contrato_id"/>
        <field name="descripcion"/>
        <field name="prioridad"/>
        <field name="fecha_reporte"/>
        <field name="fecha_resolucion"/>
        <field name="tecnico_asignado"/>
        <field name="estado"/>
        <field name="color"/>
        <progressbar field="prioridad" colors='{"baja": "success", "media": "warning", "alta": "danger", "critica": "danger"}'/>
        <templates>
          <t t-name="kanban-box">
            <div class="oe_kanban_card oe_kanban_global_click o_has_icon">
              <div class="oe_kanban_content">
                <div class="o_kanban_record_top mb16">
                  <div class="o_kanban_record_headings">
                    <strong class="o_kanban_record_title">
                      <field name="cliente_id"/>
                    </strong>
                    <small class="o_kanban_record_subtitle text-muted">
                      Ticket #<field name="id"/>
                    </small>
                  </div>
                  <div class="o_kanban_manage_button_section">
                    <a class="o_kanban_manage_toggle_button" href="#">
                      <i class="fa fa-ellipsis-v" role="img" aria-label="Manage" title="Manage"/>
                    </a>
                  </div>
                </div>
                <div class="o_kanban_record_body">
                  <field name="descripcion" class="text-muted"/>
                </div>
                <div class="o_kanban_record_bottom">
                  <div class="oe_kanban_bottom_left">
                    <div class="o_kanban_inline_block">
                      <field name="prioridad" widget="priority"/>
                    </div>
                    <div class="o_kanban_inline_block">
                      <i class="fa fa-calendar" role="img" aria-label="Date" title="Date"/>
                      <field name="fecha_reporte" widget="date"/>
                    </div>
                  </div>
                  <div class="oe_kanban_bottom_right">
                    <field name="tecnico_asignado" widget="many2one_avatar_user"/>
                  </div>
                </div>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="action_tickets" model="ir.actions.act_window">
    <field name="name">Tickets de Soporte</field>
    <field name="res_model">internet.tickets</field>
    <field name="view_mode">kanban,tree,form</field>
  </record>

  <menuitem id="menu_tickets" 
            name="Tickets" 
            parent="menu_internet_root"
            action="action_tickets"/>

</odoo>