<odoo>
    <record id="seq_internet_tickets" model="ir.sequence">
        <field name="name">Tickets de Soporte</field>
        <field name="code">internet.tickets</field>
        <field name="prefix">TICK</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <record id="seq_internet_instalacion" model="ir.sequence">
        <field name="name">Instalaciones</field>
        <field name="code">internet.instalacion</field>
        <field name="prefix">INST</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <record id="seq_internet_pagos" model="ir.sequence">
        <field name="name">Pagos</field>
        <field name="code">internet.pagos</field>
        <field name="prefix">PAG</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <record id="seq_internet_aviso_cobro" model="ir.sequence">
        <field name="name">Avisos de Cobro</field>
        <field name="code">internet.aviso_cobro</field>
        <field name="prefix">AV</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

</odoo>