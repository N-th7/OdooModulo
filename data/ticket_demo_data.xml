            <field name="estado">abierto</field>
            <field name="prioridad">alta</field>
            <field name="fecha_reporte">2025-12-24 08:00:00</field>
        </record>

        <record id="ticket_demo_2" model="internet.tickets">
            <field name="cliente_id" ref="client_demo_2"/>
            <field name="descripcion">No hay conexión a internet desde esta mañana. El modem no enciende.</field>
            <field name="estado">en_proceso</field>
            <field name="prioridad">critica</field>
            <field name="fecha_reporte">2025-12-24 09:30:00</field>
            <field name="tecnico_asignado" ref="base.user_admin"/>
        </record>

        <record id="ticket_demo_3" model="internet.tickets">
